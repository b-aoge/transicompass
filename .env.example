# 转型罗盘 TranSiCompass — 环境变量样例
# 复制为 .env 后填写。本文件只列 key 名，禁止写入任何真实密钥。

# ---------- 应用 ----------
NODE_ENV=development
APP_VERSION=dev
APP_BASE_URL=http://localhost:3000

# ---------- 数据库 ----------
# PostgreSQL 17
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transicompass?schema=public
# Redis 7.4；留空则自动降级为进程内内存计数（单实例可用，见 Spec 11.4）
REDIS_URL=

# ---------- 加密（生产由 KMS 凭据管家注入，切勿入库） ----------
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTACT_HASH_PEPPER=
# 生成：node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ---------- LLM 主：阿里云百炼（OpenAI 兼容协议） ----------
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
LLM_MODEL_EXTRACT=qwen-flash
LLM_MODEL_MATCH=qwen3.7-plus

# ---------- LLM 备：DeepSeek ----------
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
LLM_FALLBACK_MODEL=deepseek-v4-pro

# 主备 API Key 均为空时，服务端使用确定性 mock 生成器产出符合 Zod schema 的结果，
# 保证本地端到端可跑通。mock 输出随 sanitized_text 变化，不是写死数据。
# 置 true 可在已配置 Key 的环境下强制走 mock（用于回归测试）。
LLM_FORCE_MOCK=false

# ---------- 合规公示 ----------
AI_SERVICE_REGISTRATION_NO=
ALGORITHM_FILING_NO=
PRIVACY_POLICY_VERSION=2026-08-01

# ---------- 短信与邮件 ----------
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 非生产环境下把验证码写入 Redis key authcode:test:<phone> 供 E2E 读取（Spec T6.1）。
# 生产环境该开关被强制忽略。
AUTH_TEST_CODE_CHANNEL=true

# ---------- 限流阈值 ----------
RATE_DIAGNOSIS_PER_SID_HOUR=5
RATE_DIAGNOSIS_PER_IP_HOUR=20
RATE_LEAD_PER_SID_HOUR=3
RATE_EXPORT_PER_USER_HOUR=10
