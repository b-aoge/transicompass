# ---------- 依赖与构建产物 ----------
node_modules/
.next/
out/
build/
# dist/ 下仅忽略构建产物，保留岗位数据文件（被 app/transicompass.html 读取）
dist/*
!dist/jobs_data.json
coverage/

# ---------- 环境变量（真实密钥绝不入库；.env.example 可入库） ----------
.env
.env.local
.env.*.local

# ---------- 类型/生成产物 ----------
src/generated/
*.tsbuildinfo
next-env.d.ts

# ---------- 日志 ----------
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
install.log

# ---------- 编辑器/OS ----------
.DS_Store
Thumbs.db
.idea/
.vscode/

# ---------- 项目本地文件（不入库） ----------
# 本地快照回退（代替 git 的版本管理，体积大、含历史密钥）
_backups/
# WorkBuddy 内部记忆
.workbuddy/
# 线上真机页存档（含历史硬编码 Key 的大体积 HTML 快照）
docs/snapshots/
# 意外产生的 0 字节文件
docs/nul
